{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"tampabay-explorer-proxy-guard",
  "main":"workers/proxy-guard.ts",
  "compatibility_date":"2026-11-04",
  "workers_dev":false,
  "preview_urls":false,
  "durable_objects":{"bindings":[{"name":"PROXY_GUARD","class_name":"ProxyGuard"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["ProxyGuard"]}],
  "observability":{"enabled":true,"traces":{"enabled":true}}
}
